<?xml version="1.0" encoding="utf-8"?>
<!--
  本机 Visual Studio 的全局配置
  (C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config)
  声明了一个 fallbackPackageFolder 指向 d:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages，
  但这台机器没有 D 盘，导致所有 dotnet restore 直接失败（NU1301）。

  这里在本目录下清空继承来的 fallback 目录，只保留可用的包源。
  该文件会作用于 pc-companion 下所有 .NET 工程（Windows / Mac），
  且不需要管理员权限、不污染用户或系统级配置。
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
