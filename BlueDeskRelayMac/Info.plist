    <string>BlueDesk Relay</string>
    <key>CFBundleDisplayName</key>
    <string>BlueDesk 互传助手</string>
    <key>CFBundleIdentifier</key>
    <string>com.lingzhi.bluedesk.relay-mac</string>
    <key>CFBundleIconFile</key>
